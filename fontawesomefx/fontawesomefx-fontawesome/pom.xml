<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.jimmyboombots3000</groupId><artifactId>fontawesomefx-parent</artifactId><version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <artifactId>fontawesomefx-fontawesome</artifactId>
  <name>fontawesomefx-fontawesome</name>
  <properties><license.directory>${project.basedir}/../..</license.directory></properties>
  <dependencies>
    <dependency><groupId>io.github.jimmyboombots3000</groupId><artifactId>fontawesomefx-commons</artifactId></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-fxml</artifactId></dependency>
  </dependencies>
  <build><plugins>
    <plugin>
      <groupId>org.codehaus.mojo</groupId>
      <artifactId>build-helper-maven-plugin</artifactId>
      <version>3.6.2</version>
      <executions><execution>
        <id>fontawesome-generated-sources</id>
        <phase>generate-sources</phase>
        <goals><goal>add-source</goal></goals>
        <configuration><sources>
          <source>${project.build.directory}/generated-sources/fontawesome</source>
        </sources></configuration>
      </execution></executions>
    </plugin>
    <plugin>
      <groupId>org.codehaus.gmavenplus</groupId>
      <artifactId>gmavenplus-plugin</artifactId>
      <version>4.3.1</version>
      <configuration><includeClasspath>PLUGIN_ONLY</includeClasspath></configuration>
      <dependencies>
        <dependency><groupId>org.apache.groovy</groupId><artifactId>groovy</artifactId><version>4.0.24</version></dependency>
        <dependency><groupId>org.apache.groovy</groupId><artifactId>groovy-json</artifactId><version>4.0.24</version></dependency>
      </dependencies>
      <executions><execution>
        <id>generate-fontawesome</id>
        <phase>generate-sources</phase>
        <goals><goal>execute</goal></goals>
        <configuration><scripts>
          <script>${project.basedir}/../../scripts/generate-fontawesome.groovy</script>
        </scripts></configuration>
      </execution></executions>
    </plugin>
    <plugin><groupId>org.openjfx</groupId><artifactId>javafx-maven-plugin</artifactId>
      <configuration><mainClass>de.jensd.fx.fontawesomefx.fontawesome/io.github.jimmyboombots3000.fontawesomefx.viewer.IconViewer</mainClass></configuration>
    </plugin>
    <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
      <configuration><archive><manifest><mainClass>io.github.jimmyboombots3000.fontawesomefx.viewer.IconViewer</mainClass></manifest></archive></configuration>
    </plugin>
  </plugins></build>
  <profiles>
    <profile>
      <id>update-fontawesome</id>
      <build><plugins><plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
        <executions><execution>
          <id>import-fontawesome</id>
          <phase>initialize</phase>
          <goals><goal>execute</goal></goals>
          <configuration><scripts>
            <script>${project.basedir}/../../scripts/update-fontawesome.groovy</script>
          </scripts></configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>

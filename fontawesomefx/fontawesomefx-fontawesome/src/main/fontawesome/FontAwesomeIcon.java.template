package de.jensd.fx.glyphs.fontawesome;

import de.jensd.fx.glyphs.GlyphIcons;

/**
 * Font Awesome Free @FONT_VERSION@. Generated by scripts/generate-fontawesome.groovy; do not edit.
 * Regular variants use REGULAR_; historical enum names remain available.
 */
public enum FontAwesomeIcon implements GlyphIcons {

@ICON_CONSTANTS@;

    private final String unicode;
    private final String fontFamily;

    FontAwesomeIcon(int codePoint, String fontFamily) {
        this.unicode = new String(Character.toChars(codePoint));
        this.fontFamily = fontFamily;
    }

    @Override
    public String unicode() {
        return unicode;
    }

    @Override
    public String fontFamily() {
        return fontFamily;
    }
}
